# ===== LINE =====
LINE_CHANNEL_SECRET=ここにLINE Channel Secretを入力
LINE_CHANNEL_ACCESS_TOKEN=ここにLINE Access Tokenを入力
LINE_USER_ID=ここに自分のLINEユーザーIDを入力

# ===== Anthropic =====
ANTHROPIC_API_KEY=ここにAnthropicのAPIキーを入力

# ===== GitHub =====
GITHUB_TOKEN=ここにGitHub Personal Access Tokenを入力
GITHUB_USERNAME=ここにGitHubのユーザー名を入力

# ===== App =====
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost
DB_PATH=/app/db/projects.db
OUTPUT_BASE=/app/projects
PREVIEW_BASE=/app/previews
MAX_RETRY_COUNT=3
LOG_LEVEL=info
